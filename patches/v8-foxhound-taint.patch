+template <typename Char>
+void JsonParser<Char>::SetJsonPathKey(const JsonString& key) {
+  JsonPathEntry& entry = path_stack_.back();
+  entry.key_is_index = key.is_index();
+  if (!entry.key_is_index) {
+    entry.key_start = key.start();
+    entry.key_length = key.length();
+    entry.key_has_escape = key.has_escape();
+  }
+}
+
+template <typename Char>
+std::u16string JsonParser<Char>::CurrentJsonPath() {
+  std::u16string path(u"$");
+  for (const JsonPathEntry& entry : path_stack_) {
+    if (entry.is_array) {
+      std::string index = std::to_string(entry.index);
+      path.push_back(u'[');
+      path.append(index.begin(), index.end());
+      path.push_back(u']');
+    } else {
+      path.push_back(u'.');
+      if (entry.key_is_index) {
+        path.push_back(u'!');
+      } else if (entry.key_has_escape) {
+        std::vector<base::uc16> decoded(entry.key_length);
+        DecodeString(decoded.data(), entry.key_start, entry.key_length);
+        path.append(decoded.begin(), decoded.end());
+      } else {
+        path.append(chars_ + entry.key_start,
+                    chars_ + entry.key_start + entry.key_length);
+      }
+    }
+  }
+  return path;
+}
