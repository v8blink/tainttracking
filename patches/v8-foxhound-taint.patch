+SafeStringTaint StringBuilderConcatTaint(Tagged<String> special,
+                                         Tagged<FixedArray> fixed_array,
+                                         int array_length) {
+  DisallowGarbageCollection no_gc;
+  SafeStringTaint taint;
+  bool special_tainted = special->IsTainted();
+  uint32_t position = 0;
+  for (int i = 0; i < array_length; i++) {
+    Tagged<Object> element = fixed_array->get(i);
+    if (IsSmi(element)) {
+      int encoded_slice = Smi::ToInt(element);
+      int pos;
+      int len;
+      if (encoded_slice > 0) {
+        pos = StringBuilderSubstringPosition::decode(encoded_slice);
+        len = StringBuilderSubstringLength::decode(encoded_slice);
+      } else {
+        pos = Smi::ToInt(fixed_array->get(++i));
+        len = -encoded_slice;
+      }
+      if (special_tainted) {
+        taint.concat(SafeStringTaint(special->GetTaint(),
+                                     static_cast<uint32_t>(pos),
+                                     static_cast<uint32_t>(pos + len)),
+                     position);
+      }
+      position += static_cast<uint32_t>(len);
+    } else {
+      Tagged<String> string = Cast<String>(element);
+      if (string->IsTainted()) {
+        taint.concat(string->GetTaint(), position);
+      }
+      position += string->length();
+    }
+  }
+  return taint;
+}
