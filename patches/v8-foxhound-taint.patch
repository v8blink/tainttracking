+
+namespace v8 {
+namespace internal {
+
+namespace {
+
+const StringTaint& EmptyStringTaintRef() {
+  static const StringTaint empty;
+  return empty;
+}
+
+const StringTaint* ExternalResourceTaint(const String* self) {
+  StringShape shape(self);
+  if (shape.IsExternalOneByte()) {
+    const ExternalOneByteString::Resource* resource =
+        Cast<ExternalOneByteString>(self)->resource();
+    return resource ? resource->GetTaintPtr() : nullptr;
+  }
+  if (shape.IsExternalTwoByte()) {
+    const ExternalTwoByteString::Resource* resource =
+        Cast<ExternalTwoByteString>(self)->resource();
+    return resource ? resource->GetTaintPtr() : nullptr;
+  }
+  return nullptr;
+}
+
+void EmitTaintReportEvent(Isolate* isolate, DirectHandle<String> str,
+                          const char* name) {
+  v8::Isolate* api_isolate = reinterpret_cast<v8::Isolate*>(isolate);
+  if (!api_isolate->InContext()) {
+    return;
+  }
+  v8::HandleScope handle_scope(api_isolate);
+  v8::Local<v8::Context> context = api_isolate->GetCurrentContext();
+  if (context.IsEmpty()) {
+    return;
+  }
+  v8::Context::Scope context_scope(context);
+  MarkTaintOperation(isolate, *str, name);
+  v8::TryCatch try_catch(api_isolate);
+  static const char kReportBody[] =
+      "if (typeof window !== 'undefined' && typeof document !== 'undefined') {"
+      "var e = document.createEvent('CustomEvent');"
+      "var info = { str: str, sink: sink, loc: location.href };"
+      "e.initCustomEvent('__taintreport', true, false, info);"
+      "window.dispatchEvent(e); }";
+  v8::Local<v8::String> body;
+  if (!v8::String::NewFromUtf8(api_isolate, kReportBody).ToLocal(&body)) {
+    return;
+  }
+  v8::Local<v8::String> arg_names[2];
+  if (!v8::String::NewFromUtf8(api_isolate, "str").ToLocal(&arg_names[0]) ||
+      !v8::String::NewFromUtf8(api_isolate, "sink").ToLocal(&arg_names[1])) {
+    return;
+  }
+  v8::ScriptCompiler::Source source(body);
+  v8::Local<v8::Function> report;
+  if (!v8::ScriptCompiler::CompileFunction(context, &source, 2, arg_names)
+           .ToLocal(&report)) {
+    return;
+  }
+  v8::Local<v8::String> v8_sink;
+  if (!v8::String::NewFromUtf8(api_isolate, name).ToLocal(&v8_sink)) {
+    return;
+  }
+  v8::Local<v8::Value> argv[2] = {Utils::ToLocal(str), v8_sink};
+  v8::Local<v8::Value> result;
+  USE(report->Call(context, v8::Undefined(api_isolate), 2, argv)
+          .ToLocal(&result));
+}
+
+}  // namespace
+
+std::u16string TaintStringToU16(Tagged<String> str) {
+  std::u16string out;
+  if (str.is_null()) {
+    return out;
+  }
+  uint32_t len = str->length();
+  out.reserve(len);
+  for (uint32_t i = 0; i < len; i++) {
+    out.push_back(static_cast<char16_t>(str->Get(i)));
+  }
+  return out;
+}
+
+TaintMd5 ScriptSourceMd5(Isolate* isolate, DirectHandle<Script> script) {
+  TaintMd5 digest = {};
+  Tagged<Object> src = script->source();
+  if (!IsString(src)) {
+    return digest;
+  }
+  DirectHandle<String> source(Cast<String>(src), isolate);
+  DirectHandle<String> flat = String::Flatten(isolate, source);
+  uint32_t len = flat->length();
+  std::string bytes;
+  bytes.reserve(len);
+  for (uint32_t i = 0; i < len; i++) {
+    bytes.push_back(static_cast<char>(flat->Get(i) & 0xff));
+  }
+  MD5Context ctx;
+  MD5Init(&ctx);
+  MD5Update(&ctx, reinterpret_cast<const unsigned char*>(bytes.data()),
+            static_cast<unsigned>(bytes.size()));
+  MD5Final(digest.data(), &ctx);
+  return digest;
+}
+
+TaintLocation TaintLocationFromStack(Isolate* isolate) {
+  if (isolate == nullptr) {
+    return TaintLocation();
+  }
+  for (DebuggableStackFrameIterator it(isolate); !it.done(); it.Advance()) {
+    FrameSummary summary = it.GetTopValidFrame();
+    if (!summary.IsJavaScript()) {
+      continue;
+    }
+    DirectHandle<Object> script_obj = summary.script();
+    if (!IsScript(*script_obj)) {
+      continue;
+    }
+    DirectHandle<Script> script = Cast<Script>(script_obj);
+    if (!script->IsUserJavaScript()) {
+      continue;
+    }
+    int position = summary.SourcePosition();
+    Script::PositionInfo info;
+
+    std::u16string filename;
+    Tagged<Object> name = script->name();
+    if (IsString(name)) {
+      filename = TaintStringToU16(Cast<String>(name));
+    }
+
+    std::u16string function;
+    TaintMd5 hash = {};
+    if (script->has_line_ends()) {
+      Script::GetPositionInfo(script, position, &info);
+    } else if (IsString(script->source()) &&
+               Cast<String>(script->source())->IsFlat()) {
+      String::LineEndsVector ends = Script::GetLineEnds(isolate, script);
+      script->GetPositionInfoWithLineEnds(position, &info, ends);
+    }
+    if (IsString(script->source()) &&
+        Cast<String>(script->source())->IsFlat()) {
+      hash = ScriptSourceMd5(isolate, script);
+    }
+    uint32_t line = static_cast<uint32_t>(info.line + 1);
+    uint32_t pos = static_cast<uint32_t>(info.column + 1);
+    uint32_t start_line = static_cast<uint32_t>(script->line_offset());
+    return TaintLocation(filename, line, pos, line, pos, start_line, hash,
+                         function);
+  }
+  return isolate->fallback_taint_location();
+}
+
+TaintOperation TaintOperationFromStack(Isolate* isolate, const char* name) {
+  return TaintOperation(name, TaintLocationFromStack(isolate));
+}
+
+TaintOperation TaintOperationFromStack(Isolate* isolate, const char* name,
+                                       std::vector<std::u16string> args) {
+  return TaintOperation(name, TaintLocationFromStack(isolate), std::move(args));
+}
+
+void MarkTaintSource(Isolate* isolate, Tagged<String> str, const char* name,
+                     std::vector<std::u16string> args) {
+  if (str.is_null() || str->length() == 0) {
+    return;
+  }
+  TaintOperation op(name, TaintLocationFromStack(isolate), std::move(args));
+  op.setSource();
+  StringTaint taint;
+  taint.overlay(0, str->length(), op);
+  str->SetTaint(isolate, taint);
+}
+
+void MarkTaintOperation(Isolate* isolate, Tagged<String> str, const char* name,
+                        std::vector<std::u16string> args) {
+  if (str.is_null() || !str->IsTainted()) {
+    return;
+  }
+  TaintOperation op(name, TaintLocationFromStack(isolate), std::move(args));
+  SafeStringTaint taint = str->GetTaint().safeCopy();
+  taint.extend(op);
+  str->SetTaint(isolate, taint);
+}
+
+void PropagateTaint(Isolate* isolate, Tagged<String> source,
+                    Tagged<String> result, const char* name,
+                    std::vector<std::u16string> args) {
+  if (source.is_null() || result.is_null() || !source->IsTainted()) {
+    return;
+  }
+  SafeStringTaint taint = source->GetTaint().safeCopy();
+  taint.extend(TaintOperation(name, TaintLocationFromStack(isolate),
+                              std::move(args)));
+  result->SetTaint(isolate, taint);
+}
+
+void PropagateTaintRange(Isolate* isolate, Tagged<String> source,
+                         uint32_t begin, uint32_t end, Tagged<String> result,
+                         const char* name) {
+  if (source.is_null() || result.is_null() || !source->IsTainted()) {
+    return;
+  }
+  SafeStringTaint taint = SafeStringTaint(source->GetTaint(), begin, end);
+  taint.extend(TaintOperation(name, TaintLocationFromStack(isolate)));
+  result->SetTaint(isolate, taint);
+}
+
+void PropagateTaintConcat(Isolate* isolate, Tagged<String> left,
+                          Tagged<String> right, Tagged<String> result,
+                          const char* name) {
+  if (left.is_null() || right.is_null() || result.is_null()) {
+    return;
+  }
+  if (!left->IsTainted() && !right->IsTainted()) {
+    return;
+  }
+  SafeStringTaint taint = left->GetTaint().safeCopy();
+  taint.concat(right->GetTaint(), left->length());
+  taint.extend(TaintOperation(name));
+  result->SetTaint(isolate, taint);
+}
+
+bool ReportTaintSink(Isolate* isolate, Tagged<String> str, const char* name) {
+  if (str.is_null() || !str->IsTainted()) {
+    return false;
+  }
+  DirectHandle<String> handle(str, isolate);
+  MarkTaintOperation(isolate, *handle, name);
+  EmitTaintReportEvent(isolate, handle, name);
+  return true;
+}
+
+void MarkTaintedFunctionArguments(
+    Isolate* isolate, DirectHandle<JSFunction> function,
+    base::Vector<const DirectHandle<Object>> args) {
+  bool tainted = false;
+  for (size_t i = 0; i < args.size(); i++) {
+    if (IsString(*args[i]) && Cast<String>(*args[i])->IsTainted()) {
+      tainted = true;
+      break;
+    }
+  }
+  if (!tainted) {
+    return;
+  }
+  auto IntToU16 = [](int value) {
+    std::string digits = std::to_string(value);
+    return std::u16string(digits.begin(), digits.end());
+  };
+  DirectHandle<SharedFunctionInfo> shared(function->shared(), isolate);
+  std::u16string name =
+      TaintStringToU16(*SharedFunctionInfo::DebugName(isolate, shared));
+  std::u16string sourceinfo(u"unknown");
+  if (IsScript(shared->script())) {
+    DirectHandle<Script> script(Cast<Script>(shared->script()), isolate);
+    std::u16string filename;
+    if (IsString(script->name())) {
+      filename = TaintStringToU16(Cast<String>(script->name()));
+    }
+    int line = Script::GetLineNumber(script, shared->StartPosition());
+    if (line < 0) {
+      line = -1;
+    }
+    sourceinfo = filename + u":" + IntToU16(line + 1);
+  }
+  TaintLocation location = TaintLocationFromStack(isolate);
+  for (size_t i = 0; i < args.size(); i++) {
+    if (!IsString(*args[i])) {
+      continue;
+    }
+    Tagged<String> str = Cast<String>(*args[i]);
+    if (!str->IsTainted()) {
+      continue;
+    }
+    SafeStringTaint taint = str->GetTaint().safeCopy();
+    taint.extend(TaintOperation(
+        "function", location,
+        {name, sourceinfo, IntToU16(static_cast<int>(i)),
+         IntToU16(static_cast<int>(args.size()))}));
+    str->SetTaint(isolate, taint);
+  }
+}
+
+void String::InitTaintField(IsolateForSandbox isolate) {
+  taint_.Init(address(), isolate, kNullAddress);
+}
+
+const StringTaint& String::GetTaint() const {
+  Isolate* isolate = Isolate::Current();
+  Address value = taint_.load(isolate);
+  if (value != kNullAddress) {
+    return *reinterpret_cast<const StringTaint*>(value);
+  }
+  const StringTaint* external = ExternalResourceTaint(this);
+  if (external != nullptr) {
+    return *external;
+  }
+  return EmptyStringTaintRef();
+}
+
+bool String::IsTainted() const { return GetTaint().hasTaint(); }
+
+void String::SetTaint(IsolateForSandbox isolate, const StringTaint& taint) {
+  if (length() == 0) {
+    return;
+  }
+  if (!CanCarryTaint()) {
+    return;
+  }
+  if (!taint.hasTaint()) {
+    ClearTaint(isolate);
+    return;
+  }
+  Address value = taint_.load(isolate);
+  StringTaint* slot = reinterpret_cast<StringTaint*>(value);
+  if (slot == nullptr) {
+    slot = new StringTaint(taint);
+    // The taint field may still hold a null external-pointer handle: strings
+    // are created with taint = null handle (via store_encoded/Torque), not an
+    // allocated table entry. In that case store() would call
+    // ExternalPointerTable::Set() with a null handle and DCHECK-fail, so
+    // allocate a fresh table entry via Init() instead. If an entry already
+    // exists (e.g. it was allocated by InitTaintField or left behind by
+    // ClearTaint), update it in place via store().
+    if (taint_.load_encoded() == kNullExternalPointer) {
+      taint_.Init(address(), isolate, reinterpret_cast<Address>(slot));
+    } else {
+      taint_.store(isolate, reinterpret_cast<Address>(slot));
+    }
+    Isolate::Current()->heap()->RegisterTaintedString(Tagged(this));
+  } else {
+    *slot = taint;
+  }
+}
+
+void String::ClearTaint(IsolateForSandbox isolate) {
+  Address value = taint_.load(isolate);
+  if (value != kNullAddress) {
+    delete reinterpret_cast<StringTaint*>(value);
+    taint_.store(isolate, kNullAddress);
+  }
+}
+
+}  // namespace internal
+}  // namespace v8
